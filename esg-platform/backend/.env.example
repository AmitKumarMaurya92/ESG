# ── Application ───────────────────────────────────────────────────────────────
APP_NAME="ESG Intelligence Platform"
APP_VERSION="0.1.0"
DEBUG=true
ENVIRONMENT=development

# ── API ───────────────────────────────────────────────────────────────────────
API_V1_PREFIX=/api/v1
# Comma-separated list of allowed CORS origins
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Supabase ──────────────────────────────────────────────────────────────────
# Get these from your Supabase project → Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# WARNING: This key has admin access. NEVER expose it to the frontend.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Database ──────────────────────────────────────────────────────────────────
# Connection string for SQLAlchemy (use Supabase's pooler URL for production)
DATABASE_URL=postgresql+asyncpg://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── AI / LLM ──────────────────────────────────────────────────────────────────
# Supported providers: openai | gemini | anthropic
LLM_PROVIDER=openai
LLM_API_KEY=sk-your-openai-api-key-here
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# ── Redis / Celery ────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Supabase Storage ──────────────────────────────────────────────────────────
STORAGE_BUCKET=esg-documents

# ── URLs ──────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# ── Security ──────────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=50
